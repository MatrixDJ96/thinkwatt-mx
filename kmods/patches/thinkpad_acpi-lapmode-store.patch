@@ -10534,6 +10544,38 @@
  * dytc_profile_set: Function to register with platform_profile
  * handler. Sets current platform profile.
  */
+/*
+ * Write 0 to leave lap mode, 1 to enter it, through the same DYTC set command
+ * the firmware's own EC query issues. The EC keeps its own opinion, so the
+ * change holds until the EC decides again; the completion event refreshes
+ * lap_state and notifies the attribute as for any other change.
+ */
+static ssize_t dytc_lapmode_store(struct device *dev,
+				  struct device_attribute *attr,
+				  const char *buf, size_t count)
+{
+	bool wanted;
+	int output, err;
+
+	if (!has_lapsensor)
+		return -ENODEV;
+
+	err = kstrtobool(buf, &wanted);
+	if (err)
+		return err;
+
+	err = mutex_lock_interruptible(&dytc_mutex);
+	if (err)
+		return err;
+	err = dytc_command(wanted ? DYTC_ENABLE_CQL : DYTC_DISABLE_CQL, &output);
+	mutex_unlock(&dytc_mutex);
+	if (err)
+		return err;
+
+	lapsensor_refresh();
+	return count;
+}
