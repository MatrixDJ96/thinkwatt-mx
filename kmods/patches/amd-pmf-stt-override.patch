+/* Sends the override, if one is set, on the PMF mailbox. */
+void amd_pmf_apply_stt_override(struct amd_pmf_dev *pmf)
+{
+	if (!pmf->stt_apu_override)
+		return;
+	amd_pmf_send_cmd(pmf, SET_STT_LIMIT_APU, SET_CMD,
+			 fixp_q88_fromint(pmf->stt_apu_override), NULL);
+}
+
+/*
+ * The skin-temperature target the SMU holds the APU to, in degrees C. The BIOS
+ * table gives one per profile and power source, pushed by the static slider
+ * where the platform has it or by the SBIOS on the OS power slider update.
+ * A non-zero value here is sent at once and again after every such push the
+ * driver makes; 0 stops that and puts the table back at once: the static
+ * slider's own value where the platform has one, otherwise the value the SMU
+ * reported before the override began, since the SBIOS does not push its table
+ * again for a slider position that has not moved.
+ */
+static ssize_t stt_skin_temp_apu_show(struct device *dev,
+				      struct device_attribute *attr, char *buf)
+{
+	struct amd_pmf_dev *pdev = dev_get_drvdata(dev);
+
+	return sysfs_emit(buf, "%u\n", pdev->stt_apu_override);
+}
+
+static ssize_t stt_skin_temp_apu_store(struct device *dev,
+				       struct device_attribute *attr,
+				       const char *buf, size_t count)
+{
+	struct amd_pmf_dev *pdev = dev_get_drvdata(dev);
+	u32 val;
+	int err;
+
+	err = kstrtou32(buf, 10, &val);
+	if (err)
+		return err;
+	if (val > U8_MAX)
+		return -EINVAL;
+
+	if (val && !pdev->stt_apu_override && pdev->pmf_if_version == PMF_IF_V1) {
+		err = amd_pmf_send_cmd(pdev, GET_STT_LIMIT_APU, GET_CMD, ARG_NONE,
+				       &pdev->stt_apu_table);
+		if (err)
+			return err;
+	}
+	pdev->stt_apu_override = val;
+	if (val) {
+		amd_pmf_apply_stt_override(pdev);
+		return count;
+	}
+	if (is_apmf_func_supported(pdev, APMF_FUNC_STATIC_SLIDER_GRANULAR)) {
+		err = amd_pmf_set_sps_power_limits(pdev);
+		if (err)
+			return err;
+	} else if (pdev->stt_apu_table) {
+		err = amd_pmf_send_cmd(pdev, SET_STT_LIMIT_APU, SET_CMD, pdev->stt_apu_table,
+				       NULL);
+		if (err)
+			return err;
+	}
+	pdev->stt_apu_table = 0;
+
+	return count;
+}
+static DEVICE_ATTR_RW(stt_skin_temp_apu);
+
+/*
+ * The limits the SMU holds now, read back through the same mailbox: the power
+ * limits in mW, the two skin-temperature targets in degrees C.
+ */
+static ssize_t power_limits_show(struct device *dev,
+				 struct device_attribute *attr, char *buf)
+{
+	struct amd_pmf_dev *pdev = dev_get_drvdata(dev);
+	u32 val[7] = {};
+	static const u8 cmd[7] = { GET_SPL, GET_FPPT, GET_SPPT, GET_SPPT_APU_ONLY,
+				   GET_STT_MIN_LIMIT, GET_STT_LIMIT_APU, GET_STT_LIMIT_HS2 };
+	int i, err;
+
+	for (i = 0; i < ARRAY_SIZE(cmd); i++) {
+		err = amd_pmf_send_cmd(pdev, cmd[i], GET_CMD, ARG_NONE, &val[i]);
+		if (err)
+			return err;
+	}
+
+	return sysfs_emit(buf,
+			  "spl=%u fppt=%u sppt=%u sppt_apu_only=%u stt_min=%u stt_apu=%u.%02u stt_hs2=%u.%02u\n",
+			  val[0], val[1], val[2], val[3], val[4],
+			  val[5] >> 8, (val[5] & 0xff) * 100 / 256,
+			  val[6] >> 8, (val[6] & 0xff) * 100 / 256);
+}
+static DEVICE_ATTR_RO(power_limits);
+
+/*
+ * The metrics table the SMU fills on request: the temperatures in degrees C,
+ * the powers in mW, the STAPM limit in W, and the SMU's own counter, which
+ * the reference machine's firmware leaves at 0. One transfer per read, on the
+ * driver's mailbox, into the buffer the driver registers with the SMU on the
+ * first read; the layout is the V1 table, so the attribute exists only there.
+ */
+static ssize_t metrics_show(struct device *dev,
+			    struct device_attribute *attr, char *buf)
+{
+	struct amd_pmf_dev *pdev = dev_get_drvdata(dev);
+	struct smu_pmf_metrics *m = &pdev->m_table;
+	u16 core_temp = 0;
+	int i, err;
+
+	guard(mutex)(&pdev->update_mutex);
+	if (!pdev->buf) {
+		err = amd_pmf_set_dram_addr(pdev, true);
+		if (err)
+			return err;
+	}
+	memset(pdev->buf, 0, sizeof(*m));
+	err = amd_pmf_send_cmd(pdev, SET_TRANSFER_TABLE, SET_CMD, METRICS_TABLE_ID, NULL);
+	if (err)
+		return err;
+	memcpy(m, pdev->buf, sizeof(*m));
+	for (i = 0; i < ARRAY_SIZE(m->core_temp); i++)
+		core_temp = max(core_temp, m->core_temp[i]);
+
+	return sysfs_emit(buf,
+			  "skin_temp=%u.%02u core_temp=%u.%02u gfx_temp=%u.%02u soc_temp=%u.%02u apu_power=%u socket_power=%u avg_socket_power=%u stapm_limit=%u counter=%u\n",
+			  m->skin_temp / 100, m->skin_temp % 100,
+			  core_temp / 100, core_temp % 100,
+			  m->gfx_temp / 100, m->gfx_temp % 100,
+			  m->soc_temp / 100, m->soc_temp % 100,
+			  m->apu_power, m->current_socketpower, m->avg_socket_power,
+			  m->stapm_cur_limit, m->metrics_counter);
+}
+static DEVICE_ATTR_RO(metrics);
+
+static umode_t sps_override_is_visible(struct kobject *kobj,
+				       struct attribute *attr, int n)
+{
+	struct amd_pmf_dev *pdev = dev_get_drvdata(kobj_to_dev(kobj));
+
+	if (!is_apmf_func_supported(pdev, APMF_FUNC_STATIC_SLIDER_GRANULAR) &&
+	    !is_apmf_func_supported(pdev, APMF_FUNC_OS_POWER_SLIDER_UPDATE))
+		return 0;
+	/* The GET commands and the V1 metrics table exist on the V1 interface only. */
+	if ((attr == &dev_attr_power_limits.attr || attr == &dev_attr_metrics.attr) &&
+	    pdev->pmf_if_version != PMF_IF_V1)
+		return 0;
+
+	return attr->mode;
+}
+
+static struct attribute *sps_override_attrs[] = {
+	&dev_attr_stt_skin_temp_apu.attr,
+	&dev_attr_power_limits.attr,
+	&dev_attr_metrics.attr,
+	NULL
+};
+
+const struct attribute_group sps_override_attribute_group = {
+	.is_visible = sps_override_is_visible,
+	.attrs = sps_override_attrs,
+};
